# =======================================================
# BiblioGest - Configurações de Ambiente (Local & Nuvem)
# =======================================================

NODE_ENV=development
PORT=3000

# -------------------------------------------------------
# 🗄️ OPÇÃO DE BANCO DE DADOS (Escolha uma das opções)
# -------------------------------------------------------

# Para uso com Docker Compose, use o host `postgres` (nome do serviço).
DATABASE_URL="postgresql://USUARIO:senha-forte@postgres:5432/NOME_DO_BANCO?schema=public"
POSTGRES_USER=USUARIO
POSTGRES_PASSWORD=senha-forte
POSTGRES_DB=NOME_DO_BANCO

# OPÇÃO 2: PostgreSQL na Nuvem (Ex: Neon, Supabase, Render, Railway, AWS RDS)
# Descomente a linha abaixo e cole a String de Conexão fornecida pelo seu provedor de nuvem:
# DATABASE_URL="postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/bibliogest?sslmode=require"

# OPÇÃO 3: SQLite Local (Zero Instalação - Arquivo Local)
# Descomente a linha abaixo para rodar sem precisar instalar o PostgreSQL:
# DATABASE_URL="file:../database/bibliogest.db"

# -------------------------------------------------------
# 🔐 Segurança & Autenticação JWT
# -------------------------------------------------------
JWT_SECRET=gere-uma-chave-aleatoria-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=7d

# Configuração de CORS (Endereços autorizados a acessar as APIs)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# -------------------------------------------------------
# 👤 Credenciais Iniciais de Administrador
# -------------------------------------------------------
DEFAULT_ADMIN_USERNAME=administrador
# Use uma senha forte. Ela será aplicada apenas na criação inicial ou com
# `npm run admin:reset-password`.
DEFAULT_ADMIN_PASSWORD=defina-uma-senha-inicial-forte

# -------------------------------------------------------
# 🌐 URLs do Frontend / Deploy Unificado
# -------------------------------------------------------
# No deploy unificado (Front + Back na mesma porta), deixe relativo como '/api' ou 'http://localhost:3000/api'
VITE_API_URL=/api
