# Chave pública do widget Cloudflare Turnstile. Ela pode ser exposta no navegador.
# A chave secreta correspondente fica somente em backend/.env.
VITE_TURNSTILE_SITE_KEY=

# URL pública da API em produção. Em desenvolvimento, deixe vazio para usar /api.
# Exemplo: https://api-bibliogest.seu-dominio.com/api
VITE_API_URL=
