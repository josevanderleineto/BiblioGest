# Escolha uma única conexão. Deixe a alternativa que não será usada comentada.
# DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/bibliogest?schema=public"
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-DO-PROVEDOR:5432/NOME_DO_BANCO?sslmode=require"

PORT=3000
JWT_SECRET="gere-uma-chave-aleatoria-com-no-minimo-32-caracteres"
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD="defina-uma-senha-segura"

# Proteção do login contra tentativas automatizadas (ativa mesmo sem CAPTCHA).
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Ative o Cloudflare Turnstile em produção com a chave secreta do servidor.
# Nunca exponha esta chave no frontend nem a envie ao Git.
TURNSTILE_SECRET_KEY=
