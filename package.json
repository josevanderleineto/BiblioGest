{
  "name": "bibliogest",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Integrado de Gestão e Automação de Bibliotecas (BiblioGest)",
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace bibliogest-backend",
    "build:frontend": "npm run build --workspace bibliogest-frontend",
    "dev:backend": "npm run dev --workspace bibliogest-backend",
    "dev:frontend": "npm run dev --workspace bibliogest-frontend",
    "start": "npm run start --workspace bibliogest-backend",
    "db:generate": "npm run prisma:generate --workspace bibliogest-backend",
    "db:deploy": "npm run prisma:deploy --workspace bibliogest-backend",
    "db:seed": "npm run prisma:seed --workspace bibliogest-backend",
    "db:setup": "npm run db:deploy && npm run db:seed",
    "db:setup:ci": "npm run db:setup || echo 'AVISO: setup do banco nao concluido no build; verificar DATABASE_URL'",
    "db:studio": "npm exec --workspace bibliogest-backend -- prisma studio",
    "admin:reset-password": "npm run admin:reset-password --workspace bibliogest-backend"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "esbuild": true
  },
  "devDependencies": {}
}
